    },
    {
      "t": 65.9,
      "texte": "Je serai, même si la vie"
    },
    {
      "t": 69.2,
      "texte": "Nous sépare"
    },
    {
      "t": 76.6,
      "texte": "Celle qui te redonnera l'espoir"
    },
    {
      "t": 74.5,
      "texte": "On ne laissera rien au hasard"
    },
    {
      "t": 79.2,
      "texte": "Car tu sais que je resterai"
    },
    {
