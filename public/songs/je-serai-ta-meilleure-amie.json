    {
      "t": 22.2,
      "texte": "On se connait depuis"
    },
    {
      "t": 24.8,
      "texte": "Quelque temps"
    },
    {
      "t": 26.8,
      "texte": "Même si on se parlait"
    },
    {
      "t": 28.9,
      "texte": "Peu souvent"
    },
    {
      "t": 30.6,
      "texte": "C'est vrai, tu lis en moi"
    },
    {
      "t": 32.7,
      "texte": "Comme dans un livre ouvert"
    },
    {
      "t": 34.9,
      "texte": "Je te sens si fragile"
    },
    {
      "t": 36.9,
      "texte": "Le cœur à découvert"
    },
    {
      "t": 39.3,
      "texte": "J'ai envie qu'on se dise"
    },
    {
      "t": 42.9,
      "texte": "Tous nos moindres secrets"
    },
    {
      "t": 45.3,
      "texte": "Car je resterai, ta meilleure amie"
    },
    {
      "t": 49.3,
      "texte": "Je serai là , toujours pour toi"
    },
    {
      "t": 53.7,
      "texte": "N'importe où quand tu voudras"
    },
    {
      "t": 57,
      "texte": "Je serai, toujours la même"
    },
    {
      "t": 60.3,
      "texte": "Un peu bohème"
    },
    {
